#!/sbin/openrc-run
# Keep management and DHCP available even when the proxy service is stopped.
name="ShortPost isolated LAN"
depend() { need net; before dnsmasq shortpost-gateway; }
start() {
    ebegin "Preparing ShortPost isolated LAN"
    nft list table inet shortpost_guard >/dev/null 2>&1 || nft add table inet shortpost_guard || return 1
    nft -f /etc/shortpost/guard.nft || return 1
    ip link set eth1 up || return 1
    ip addr replace 10.77.0.1/24 dev eth1 || return 1
    sysctl -qw net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 || return 1
    ip route replace prohibit default metric 32760 table 100 || return 1
    ip rule show | grep -q '1000:.*iif eth1.*lookup 100' || ip rule add pref 1000 iif eth1 lookup 100 || return 1
    sysctl -qw net.ipv4.ip_forward=1 || return 1
    eend 0
}
stop() {
    # Deliberately retain the guard and unreachable fallback until VM shutdown.
    return 0
}
