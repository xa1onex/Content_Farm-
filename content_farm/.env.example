BOT_TOKEN=
GEMINI_API_KEY=
GDRIVE_FOLDER_ID=
# OAuth для личного Диска; сервисный аккаунт — только для shared drive Workspace.
GDRIVE_TOKEN_FILE=drive_token.json
GDRIVE_CLIENT_FILE=oauth_client.json
GDRIVE_SERVICE_FILE=service_account.json
BG_VIDEO=assets/jackcraft_bg.mp4
VIDEO_LAYOUT=split
MAX_SOURCE_SECONDS=7200
MAX_INPUT_BYTES=2147483648
MAX_QUEUE_SIZE=10
FFMPEG_THREADS=2
