# YOUTUBE_COOKIE_FILE=cookies.txt

# Register archived clips in ShortPost (server only).
AUTOPOST_ENABLED=false
AUTOPOST_API_URL=https://origin.xdoublegroup.online:8443/api/v1
AUTOPOST_TOKEN_FILE=autopost_credentials.json
AUTOPOST_CATEGORY_ID=
