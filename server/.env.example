# Replace passwords and key. Never commit the real .env.
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+psycopg://shortpost_owner:replace-with-random-password@db:5432/shortpost
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
ENVIRONMENT=production
PUBLIC_BASE_URL=https://origin.xdoublegroup.online:8443
DRIVE_CREDENTIALS_FILE=/run/secrets/drive_credentials
DRIVE_AUTH_TYPE=oauth
TELEGRAM_ADMIN_IDS=[]
TELEGRAM_ALLOW_ALL=true
# Standalone bot only; do not reuse a token with existing polling.
TELEGRAM_BOT_TOKEN=
RATE_LIMIT_PER_MINUTE=120
LEASE_SECONDS=180
HEARTBEAT_TIMEOUT=120
MAX_PROCESSING_SECONDS=1800
